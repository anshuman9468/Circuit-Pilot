# FastAPI service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# These may be relative to the repository root. The defaults work after copying this file.
DATABASE_PATH=data/circuitpilot.db
WORKSPACE_ROOT=data/workspaces

# Browser-safe frontend connection. This is not a credential.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Backend-only Meta model configuration. Never copy this into a NEXT_PUBLIC_* variable.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor
# Set false when intentionally using the configured fallback as the local provider.
MODEL_PRIMARY_ENABLED=true

# Optional backend-only fallback. The router selects a currently available free model.
MODEL_FALLBACK_ENABLED=false
# Keep false unless you explicitly accept replaying requests after a Meta timeout
# or connection failure; those failures can be ambiguous at the provider.
MODEL_FALLBACK_ON_TRANSIENT_ERRORS=false
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
MODEL_FALLBACK_MODEL=openrouter/free
MODEL_TIMEOUT_SECONDS=45
MAX_MODEL_ROUNDS=6
MAX_TOOL_CALLS=12
MAX_COMPLETION_TOKENS=8192
MAX_CONTEXT_CHARS=96000
MAX_TOOL_RESULT_CHARS=32000
MAX_ACTIVE_RUNS=1
MAX_USER_MESSAGE_CHARS=20000

# Phase 3: keep Meta specification drafting disabled unless explicitly enabled.
SPECIFICATION_PLANNER_ENABLED=false
MAX_PLANNER_CORRECTIONS=1

# Phase 4: keep live generation disabled unless explicitly enabled for a deliberate test.
GENERATION_ENABLED=false
MAX_GENERATION_OUTPUT_BYTES=524288
MAX_GENERATION_CORRECTIONS=1

# Phase 5: container-only engineering execution. These checks never build or pull images.
TOOLCHAIN_RUNTIME=auto
TOOLCHAIN_IMAGE=circuitpilot/toolchain:phase5
TOOLCHAIN_TIMEOUT_SECONDS=120
TOOLCHAIN_MEMORY=512m
TOOLCHAIN_CPUS=1.0
TOOLCHAIN_PIDS_LIMIT=128
TOOLCHAIN_MAX_LOG_BYTES=262144
TOOLCHAIN_MAX_ARTIFACT_BYTES=4194304
TOOLCHAIN_MAX_TOTAL_ARTIFACT_BYTES=16777216
TOOLCHAIN_MAX_SOURCE_FILES=200
TOOLCHAIN_MAX_SOURCE_BYTES=2097152
MAX_ACTIVE_EXECUTION_RUNS=1
EXECUTION_SNAPSHOT_ROOT=data/execution-snapshots
EXECUTION_OUTPUT_ROOT=data/execution-output
EXECUTION_ARTIFACT_ROOT=data/execution-artifacts
