# FastAPI service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# These may be relative to the repository root, but absolute paths are recommended.
DATABASE_PATH=/absolute/path/to/Circuit_Pilot/data/circuitpilot.db
WORKSPACE_ROOT=/absolute/path/to/Circuit_Pilot/data/workspaces

# Browser-safe frontend connection. This is not a credential.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Backend-only Meta model configuration. Never copy this into a NEXT_PUBLIC_* variable.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
MODEL_TIMEOUT_SECONDS=45
MAX_MODEL_ROUNDS=6
MAX_TOOL_CALLS=12
MAX_COMPLETION_TOKENS=2048
MAX_CONTEXT_CHARS=96000
MAX_TOOL_RESULT_CHARS=32000
MAX_ACTIVE_RUNS=1
MAX_USER_MESSAGE_CHARS=20000
